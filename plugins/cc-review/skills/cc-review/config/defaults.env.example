# shellcheck shell=bash
# shellcheck disable=SC2034
# Existing Claude session (optional; otherwise use init).
# CLAUDE_SESSION_ID=00000000-0000-0000-0000-000000000000

CLAUDE_MODEL=
CLAUDE_EFFORT=high
CLAUDE_MAX_ITERATIONS=5
CLAUDE_PERMISSION_MODE=default

# Review tools. Write is included only so Claude can create verdict.txt; the
# review prompt forbids source edits.
CLAUDE_ALLOWED_TOOLS='Read,Write,Glob,Grep,Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(rg:*),Bash(find:*),Bash(ls:*),Bash(pwd:*),Bash(sed:*),Bash(cat:*),Bash(wc:*)'

# Optional custom init instructions appended after the reviewer role.
# CLAUDE_REVIEWER_PROMPT="Explore the codebase areas relevant to the task before later reviews."

# Optional phase-specific review guidance.
# CLAUDE_PLAN_GUIDE=""
# CLAUDE_CODE_GUIDE=""
