#!/usr/bin/env bash
# sparctl — ask the sparring opponent one question inside one persistent session.
#
# Opponent: Claude Code CLI (`claude -p`, plan permission mode). This build talks to
# no other agent.
#
# The first call with a given --state file opens a session and records the id the
# provider announces, the moment it appears. Every later call with the same --state
# file resumes that session, so the opponent keeps the whole debate in view.
#
# A finished run prints one terminal line: `wrote answer: ...` on success, a line
# starting with `SPAR_` on every failure it survives. A run killed outright prints
# nothing, so `status` reports whether the turn is still alive.
#
# Derived from https://github.com/nyxandro/sparring-skill (declared MIT), reduced to the
# non-interactive path and pinned to a single opponent. See NOTICE.md next to SKILL.md.

set -euo pipefail
umask 077

SPAR_TIMEOUT="${SPAR_TIMEOUT:-3600}"        # seconds per opponent call
SPAR_KILL_AFTER="${SPAR_KILL_AFTER:-30}"    # seconds before the time cap turns into a kill
OPPONENT_CMD="claude"
# Keeps the debate between two agents: the opponent's own sparring skill is switched
# off for this call, so it answers instead of starting a debate of its own. Set to an
# empty string to leave the opponent's configuration untouched.
if [ -z "${SPAR_OPPONENT_SETTINGS+set}" ]; then
  SPAR_OPPONENT_SETTINGS='{"enabledPlugins":{"sparring@vbp1-skills":false}}'
fi
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RENDER="$HERE/render-events.py"

usage() {
  cat <<'HELPTEXT'
sparctl — ask the sparring opponent (Claude Code CLI) one question inside one session.

USAGE
  sparctl ask --state <file> --out <file> (--prompt <text> | --prompt-file <file>)
  sparctl status --state <file>
  sparctl --help

COMMANDS
  ask       Send one turn to the opponent and write its answer to --out.
            The first call for a --state file opens a session; later calls with
            the same --state file resume it. One turn at a time per session:
            a second turn against a session already in use is refused.
  status    Say whether a turn is running against this session:
              idle       nothing is running
              running    a turn is in flight; its process id is printed
              abandoned  a turn died without printing a terminal line; rerun it

OPTIONS
  --state <file>        Session file: provider name, session id, creation time.
                        Reuse it for follow-up turns of the same debate; use a fresh
                        path for an unrelated debate. Companions sit next to it:
                        <state>.id holds the session id from the moment the provider
                        announces it, <state>.transcript holds the readable record of
                        every turn including the ones that failed, and <state>.lock
                        holds the running turn's process id.
  --out <file>          Where the opponent's answer is written. Replaced atomically
                        on success, left untouched on every failure.
  --prompt <text>       Prompt text. Suitable for short follow-up turns.
  --prompt-file <file>  Read the prompt from a file. Use this for long prompts: no
                        shell quoting, no argument-size limit, nothing in the process list.
                        Mutually exclusive with --prompt.
  -h, --help            This text.

ENVIRONMENT
  SPAR_TIMEOUT      Hard cap in seconds for one opponent call (default: 3600).
  SPAR_KILL_AFTER   Seconds after the cap before the opponent is killed outright
                    (default: 30).
  SPAR_OPPONENT_SETTINGS
                    Settings JSON handed to the opponent for this call. Defaults to
                    switching off the opponent's own sparring skill. An empty string
                    leaves its configuration alone.

OUTPUT
  While the opponent works, its actions are printed as a readable log: tool calls,
  interim messages, thinking. The run then ends with one terminal line:
      wrote answer: <out> (<lines> lines, <bytes> bytes); session: <state>
      SPAR_TIMEOUT: ...   |   SPAR_FAILED: exit <code>   |   SPAR_<reason>: ...
  Exactly one line of a run starts with SPAR_, and it is the last one; diagnostics
  such as the provider's own stderr are printed without that prefix.
  Poll for a terminal line when the call runs detached, and ask `status` when no
  terminal line has appeared.

EXAMPLES
  # One turn, detached from the caller, progress visible in the log.
  setsid nohup sparctl ask --state /tmp/s.session --prompt-file /tmp/s.prompt \
         --out /tmp/s.turn1 > /tmp/s.log 2>&1 &
  tail -f /tmp/s.log

  # Follow-up turn in the same debate, also detached.
  setsid nohup sparctl ask --state /tmp/s.session \
         --prompt "Defend claim 2. The code at db/pool.rs:88 contradicts it." \
         --out /tmp/s.turn2 > /tmp/s.log2 2>&1 &

  # Is it still working?
  sparctl status --state /tmp/s.session

EXIT CODES
  0  answer written, or status reported
  1  bad arguments or a missing prerequisite (claude, python3, timeout, directories)
  2  the opponent CLI failed; its stderr is reproduced above the terminal line
  3  the opponent exited cleanly but produced an empty answer
  4  the opponent exceeded SPAR_TIMEOUT
  5  the opponent's stream reported a failed turn, or never reported a finished one
  6  the event reader could not record the turn's result
  7  another turn is already running against this session
HELPTEXT
}

SPAR_OUTCOME=""        # set once a terminal line has been printed
answer=""; err=""; fail_file=""; done_file=""; lock=""; transcript=""; prompt=""

# Runs from the exit handler, before the terminal line is printed: the lock has to be
# gone by the time a caller reads that line and starts the next turn. Nothing in here
# may fail the handler, or the run would end with no terminal line at all.
cleanup_files() {
  local f
  for f in "$answer" "$err" "$fail_file" "$done_file"; do
    [ -n "$f" ] && { rm -f "$f" || true; }
  done
  if [ -n "$lock" ] && [ -d "$lock" ]; then
    rm -rf "$lock" || true
  fi
  return 0
}

note_turn() {
  local outcome="$1"
  [ -n "$transcript" ] && [ -n "$prompt" ] || return 0
  {
    printf '\n=== TURN %s (%s) ===\n' "$(date -Is)" "$outcome"
    printf -- '--- asked ---\n%s\n' "$prompt"
    printf -- '--- outcome ---\n%s\n' "$outcome"
  } >> "$transcript" 2>/dev/null || true
  return 0
}

on_exit() {
  local code=$?
  cleanup_files
  if [ -z "$SPAR_OUTCOME" ]; then
    printf 'SPAR_FAILED: exit %s\n' "$code" >&2
    note_turn "SPAR_FAILED: exit $code"
  elif [ "$SPAR_OUTCOME" != "ok" ]; then
    note_turn "$SPAR_OUTCOME"
  fi
  return 0
}
trap on_exit EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

fail() {   # fail <exit-code> <terminal line>
  local code="$1"; shift
  SPAR_OUTCOME="$*"
  printf '%s\n' "$*" >&2
  exit "$code"
}

die() { fail 1 "SPAR_$*"; }

need_value() {
  [ "$#" -ge 2 ] || die "BAD_ARGS: $1 needs a value"
}

require_parent() {
  local path="$1" label="$2" parent
  parent="$(dirname "$path")"
  [ -d "$parent" ] || die "PARENT_MISSING: $label parent directory does not exist: $parent"
}

state_value() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -F= -v key="$key" '$1 == key { print substr($0, index($0, "=") + 1); exit }' "$file"
}

lock_holder() {
  local dir="$1"
  [ -f "$dir/pid" ] || return 0
  tr -d '[:space:]' < "$dir/pid"
}

acquire_lock() {
  local dir="$1" holder
  if mkdir "$dir" 2>/dev/null; then
    lock="$dir"; printf '%s\n' "$$" > "$dir/pid"; return 0
  fi
  holder="$(lock_holder "$dir")"
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    fail 7 "SPAR_SESSION_BUSY: turn (pid $holder) is already running against this session"
  fi
  # The holder is gone and left the lock behind: take it over.
  rm -rf "$dir"
  mkdir "$dir" 2>/dev/null || fail 7 "SPAR_SESSION_BUSY: cannot take the session lock at $dir"
  lock="$dir"; printf '%s\n' "$$" > "$dir/pid"
}

report_provider_failure() {
  local status="$1" phase="$2" err_file="$3"
  printf 'provider failed: %s exited with status %s during %s.\n' "$OPPONENT_CMD" "$status" "$phase" >&2
  if [ -s "$err_file" ]; then
    printf -- '--- provider stderr ---\n' >&2
    cat "$err_file" >&2
    printf -- '--- end provider stderr ---\n' >&2
  else
    printf -- '--- provider wrote nothing to stderr ---\n' >&2
  fi
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|help|"") usage; SPAR_OUTCOME="ok"; exit 0 ;;
  ask|status) shift ;;
  *) SPAR_OUTCOME="SPAR_UNKNOWN_COMMAND: $cmd"; printf '%s\n' "$SPAR_OUTCOME" >&2; usage >&2; exit 1 ;;
esac

state=""; out=""; prompt_file=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --state)       need_value "$@"; state="$2"; shift 2 ;;
    --out)         need_value "$@"; out="$2"; shift 2 ;;
    --prompt)      need_value "$@"; prompt="$2"; shift 2 ;;
    --prompt-file) need_value "$@"; prompt_file="$2"; shift 2 ;;
    -h|--help)     usage; SPAR_OUTCOME="ok"; exit 0 ;;
    *) die "UNKNOWN_OPTION: $1" ;;
  esac
done

[ -n "$state" ] || die "BAD_ARGS: --state is required"

if [ "$cmd" = status ]; then
  status_lock="$state.lock"
  if [ ! -d "$status_lock" ]; then
    printf 'idle: no turn is running against %s\n' "$state"
  else
    holder="$(lock_holder "$status_lock")"
    if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
      printf 'running: turn pid %s against %s\n' "$holder" "$state"
    else
      printf 'abandoned: turn pid %s died without a terminal line; rerun it\n' "${holder:-unknown}"
    fi
  fi
  SPAR_OUTCOME="ok"
  exit 0
fi

[ -n "$out" ] || die "BAD_ARGS: --out is required"
if [ -n "$prompt" ] && [ -n "$prompt_file" ]; then
  die "BAD_ARGS: pass either --prompt or --prompt-file, not both"
fi
if [ -n "$prompt_file" ]; then
  [ -f "$prompt_file" ] || die "PROMPT_FILE_MISSING: no such file: $prompt_file"
  prompt="$(cat "$prompt_file")"
fi
[ -n "$prompt" ] || die "BAD_ARGS: the prompt is empty; pass --prompt or --prompt-file"

require_parent "$state" "--state"
require_parent "$out" "--out"
command -v timeout >/dev/null 2>&1 || die "TIMEOUT_COMMAND_MISSING: GNU timeout is required"
command -v python3 >/dev/null 2>&1 || die "PYTHON_MISSING: python3 is required to read the event stream"
[ -x "$RENDER" ] || die "RENDERER_MISSING: no executable event renderer at $RENDER"
exe="$(command -v "$OPPONENT_CMD" 2>/dev/null)" \
  || die "OPPONENT_MISSING: '$OPPONENT_CMD' is not on PATH; install and authenticate it"

id_file="$state.id"
transcript="$state.transcript"

# The provider is recorded before the first turn runs, so a turn cut short still
# leaves a session file that says whose session id the companion file holds.
if [ ! -f "$state" ]; then
  {
    printf 'provider=%s\n' "$OPPONENT_CMD"
    printf 'created_at=%s\n' "$(date -Is)"
  } > "$state"
fi
stored="$(state_value "$state" provider)"
if [ -n "$stored" ] && [ "$stored" != "$OPPONENT_CMD" ]; then
  die "SESSION_PROVIDER_MISMATCH: $state belongs to '$stored', not '$OPPONENT_CMD'"
fi

acquire_lock "$state.lock"

out_dir="$(dirname "$out")"; out_base="$(basename "$out")"
answer="$(mktemp "$out_dir/.$out_base.XXXXXX")"
err="$(mktemp "$out_dir/.$out_base.stderr.XXXXXX")"
fail_file="$(mktemp "$out_dir/.$out_base.fail.XXXXXX")"
done_file="$(mktemp "$out_dir/.$out_base.done.XXXXXX")"
: > "$done_file"   # the renderer fills it only when the stream says the turn finished

session_id="$(state_value "$state" session_id)"
if [ -z "$session_id" ] && [ -f "$id_file" ] && [ -s "$id_file" ]; then
  session_id="$(tr -d '[:space:]' < "$id_file")"
fi

claude_args=(-p --permission-mode plan --output-format stream-json --verbose)
if [ -n "$SPAR_OPPONENT_SETTINGS" ]; then
  claude_args+=(--settings "$SPAR_OPPONENT_SETTINGS")
fi
if [ -n "$session_id" ]; then
  claude_args+=(--resume "$session_id")
  phase="turn continuation in session $session_id"
else
  phase="the first turn"
fi

set +e
printf '%s' "$prompt" \
  | timeout --kill-after="${SPAR_KILL_AFTER}s" "$SPAR_TIMEOUT" "$exe" "${claude_args[@]}" 2> "$err" \
  | python3 "$RENDER" --stream claude --session-file "$id_file" --answer-file "$answer" \
      --done-file "$done_file" --fail-file "$fail_file"
statuses=("${PIPESTATUS[@]}")
set -e
provider_status="${statuses[1]}"
render_status="${statuses[2]}"

if [ "$provider_status" = 124 ] || [ "$provider_status" = 137 ]; then
  fail 4 "SPAR_TIMEOUT: $OPPONENT_CMD exceeded $SPAR_TIMEOUT seconds during $phase"
fi
if [ "$provider_status" != 0 ]; then
  report_provider_failure "$provider_status" "$phase" "$err"
  fail 2 "SPAR_PROVIDER_FAILED: exit $provider_status"
fi
if [ "$render_status" != 0 ]; then
  fail 6 "SPAR_READER_FAILED: the event reader exited with status $render_status; the turn's result was not recorded"
fi
if [ -s "$fail_file" ]; then
  fail 5 "SPAR_TURN_FAILED: the opponent reported a failed turn: $(cat "$fail_file")"
fi
if [ ! -s "$done_file" ]; then
  fail 5 "SPAR_TURN_INCOMPLETE: the stream never reported a finished turn"
fi

if [ -z "$session_id" ] && [ -f "$id_file" ] && [ -s "$id_file" ]; then
  session_id="$(tr -d '[:space:]' < "$id_file")"
fi
[ -n "$session_id" ] || die "SESSION_ID_MISSING: the stream announced no session id"

if [ ! -s "$answer" ]; then
  fail 3 "SPAR_EMPTY_ANSWER: $OPPONENT_CMD exited cleanly but wrote no answer"
fi

mv "$answer" "$out"
answer=""   # moved into place; nothing left to clean up

if [ -z "$(state_value "$state" session_id)" ]; then
  printf 'session_id=%s\n' "$session_id" >> "$state"
fi
{
  printf '\n=== TURN %s (answered) ===\n' "$(date -Is)"
  printf -- '--- asked ---\n%s\n' "$prompt"
  printf -- '--- answered ---\n'
  cat "$out"
  printf '\n'
} >> "$transcript"

lines="$(awk 'END { print NR }' "$out")"
bytes="$(wc -c < "$out" | tr -d '[:space:]')"
if [ -n "$lock" ] && [ -d "$lock" ]; then
  rm -rf "$lock" || true
  lock=""
fi
printf 'wrote answer: %s (%s lines, %s bytes); session: %s\n' "$out" "$lines" "$bytes" "$state"
SPAR_OUTCOME="ok"
